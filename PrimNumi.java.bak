
class PrimNumi 
{
	public static void main(String[] args) 
	{
		int m=1;
		int n=100;
		for(int i=1;i<=100;i++)
		{

         int count=0;
		 for (int j=2;j<i;j++ )
		 {
			 if(i%j==0)
			 {
	     count++;
	    }
		 }
	    if (count==0)
	{
		System.out.println("it is prime number");
	}
	else
	{
		System.out.println("it is not a prime number");
    }
   }
}
}
